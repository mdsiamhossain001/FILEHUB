{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/FILEHUB.html" },
    { "source": "/admin/:path*", "destination": "/FILEHUB.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
